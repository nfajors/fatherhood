{
  "name": "fatherhood-school",
  "version": "0.1.0",
  "private": true,
  "description": "Fatherhood.School: subscription video academy for fathers and men considering fatherhood.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "revenue:settle": "tsx --env-file-if-exists=.env.local scripts/settle-revenue.ts",
    "themes:seed": "tsx --env-file-if-exists=.env.local scripts/themes-seed.ts",
    "themes:assign": "tsx --env-file-if-exists=.env.local scripts/themes-assign.ts",
    "gifts:deliver": "tsx --env-file-if-exists=.env.local scripts/gifts-deliver.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.11",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@cloudflare/stream-react": "1.9.3",
    "@radix-ui/react-slot": "1.2.3",
    "better-auth": "1.6.33",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "lucide-react": "0.544.0",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "resend": "6.34.1",
    "stripe": "18.5.0",
    "tailwind-merge": "3.3.1",
    "tus-js-client": "4.3.1",
    "zod": "4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    },
    "tinypool": "2.2.0"
