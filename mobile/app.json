{
  "expo": {
    "name": "Fatherhood.School",
    "slug": "fatherhood-school",
    "scheme": "fatherhoodschool",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbfaf7",
    "ios": {
      "bundleIdentifier": "school.fatherhood.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "school.fatherhood.app",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0c1a33" },
      "edgeToEdgeEnabled": true
    },
    "web": { "output": "single", "bundler": "metro" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-video", { "supportsPictureInPicture": true, "supportsBackgroundPlayback": false }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 160, "backgroundColor": "#0c1a33" }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
