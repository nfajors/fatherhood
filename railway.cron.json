{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'The scheduler needs no build.'"
  },
  "deploy": {
    "startCommand": "node scripts/cron-tick.mjs",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
