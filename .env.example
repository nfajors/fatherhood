# Copy to .env.local and fill in. Never commit real values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon or Supabase Postgres) ---
DATABASE_URL=postgres://user:password@localhost:5432/fatherhood

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring prices created in the Stripe dashboard: $19/month and $199/year.
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# --- Cloudflare Stream ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Subdomain code from https://customer-<code>.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# From POST /accounts/{id}/stream/keys: the key "id" and base64 "jwk".
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=
# Shared secret from PUT /accounts/{id}/stream/webhook.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Watermark profile uid (POST /accounts/{id}/stream/watermarks) applied to every upload.
CLOUDFLARE_STREAM_WATERMARK_UID=

# --- AI theme classifier (Claude) ---
# Without it, new content is left unthemed until an admin places it or runs the classifier later.
ANTHROPIC_API_KEY=

# --- Email (Resend) ---
# Without a key, emails are printed to the server log instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Fatherhood.School <hello@fatherhood.school>"

# --- Scheduled jobs ---
# Shared secret for /api/cron/* (Vercel Cron sends it automatically when set).
CRON_SECRET=
